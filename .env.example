# checklist-api — copy to .env for local development. NEVER commit .env.

DB_HOST=localhost
DB_PORT=55432
DB_NAME=checklist

# The APPLICATION role: ordinary, no superuser bit, no BYPASSRLS, its OWN credential.
# Row-level security does not apply to a superuser, and the official Postgres image
# creates POSTGRES_USER as one. Connecting as the owner leaves every policy present,
# correct, visible in \d, and worth nothing.
APP_DB_USER=checklist_app
APP_DB_PASSWORD=change-me

# The PRIVILEGED account — migrations and nothing else.
OWNER_DB_USER=postgres
OWNER_DB_PASSWORD=change-me

PORT=8081
# Set by the build. /version reports it, which is what makes deployment
# verifiable from outside without server access.
COMMIT_SHA=
