# Server-owned runtime configuration for checklist-api.
#
# Copied ONCE on the VPS to /opt/citadel/checklist-api/.env (chmod 600).
# CI never ships or edits the real .env - it is not in release-manifest.sh,
# so deploys preserve it. This example file documents the shape.
#
# The two passwords are the SAME values as /opt/citadel/.env (the database
# stack's file) - the databases were created with them.

APP_BASE_URL=https://api.endura-assess.com
HOST_BIND_IP=172.17.0.1
HOST_APP_PORT=8081
HOST_ROUTER_PORT=8085
OWNER_DB_PASSWORD=copy-from-/opt/citadel/.env
APP_DB_PASSWORD=copy-from-/opt/citadel/.env
